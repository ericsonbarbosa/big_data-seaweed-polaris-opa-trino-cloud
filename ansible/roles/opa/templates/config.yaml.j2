# ==============================================================================
# Open Policy Agent — Configuração do Servidor
# Gerado automaticamente pelo Ansible — NÃO EDITE MANUALMENTE
# ==============================================================================
# Variáveis definidas em: roles/opa/defaults/main.yml
# Documentação: https://www.openpolicyagent.org/docs/latest/configuration/
# ==============================================================================

{% if opa_enable_bundles %}
# ------------------------------------------------------------------------------
# Serviços (backends de onde o OPA baixa bundles)
# ------------------------------------------------------------------------------
services:
  seaweedfs_filer:
    url: {{ opa_bundle_service_url }}
    response_header_timeout_seconds: {{ opa_bundle_response_timeout }}

# ------------------------------------------------------------------------------
# Bundles (políticas distribuídas via SeaweedFS Filer)
# ------------------------------------------------------------------------------
bundles:
  trino:
    service: seaweedfs_filer
    resource: {{ opa_bundle_resource }}
    polling:
      min_delay_seconds: {{ opa_bundle_polling_min }}
      max_delay_seconds: {{ opa_bundle_polling_max }}
    persist: true
    size_limit_bytes: {{ opa_bundle_size_limit }}
{% endif %}

# ------------------------------------------------------------------------------
# Logs de decisão (auditoria)
# ------------------------------------------------------------------------------
decision_logs:
  console: true
{% if opa_log_format == "json" %}
  format: json
{% endif %}

# ------------------------------------------------------------------------------
# Status Plugin (habilita /v1/status)
# ------------------------------------------------------------------------------
status:
  console: true

# ------------------------------------------------------------------------------
# Labels (identificação do OPA no cluster)
# ------------------------------------------------------------------------------
labels:
  environment: "{{ opa_environment }}"
  role: {{ opa_role }}
  region: {{ opa_region }}
  hostname: "{{ ansible_hostname | default('unknown') }}"
  opa_version: "{{ opa_version }}"